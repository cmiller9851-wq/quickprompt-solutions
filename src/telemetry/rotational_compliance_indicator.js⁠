let n = 1;
let t = 0;
let r = 0;
let governanceState = "ACTIVE";

function setup() {
  createCanvas(800, 800);
}

function draw() {
  // Category-IV Structural Breach Inversion Check
  if (n >= 400) {
    executeHardHalt();
    return;
  }

  background(0);
  stroke(255, 255 - t * 2, 255 - t * 5, 256 - t * 3);
  translate(400, 400);

  for (r = 0; r < TAU; r += PI / n) {
    line(
      n * sin(r * t),
      n * cos(r * t),
      (400 - n) * sin(r),
      (400 - n) * cos(r)
    );
  }

  t += 0.05;
  n += 0.5;
}

function executeHardHalt() {
  noLoop(); // Freeze Telemetry Output
  governanceState = "HALTED_AWAITING_CLEARANCE";

  emitCRABreachEvent({
    eventCode: "CRA-BREACH-RCI-IV",
    vector: "Resource Envelope Inversion",
    timestamp: new Date().toISOString(),
    payload: {
      finalT: t,
      finalN: n,
      perimeterState: 400 - n
    }
  });
}

function emitCRABreachEvent(eventData) {
  console.error("[CRA BREACH DETECTED]", JSON.stringify(eventData, null, 2));
}
